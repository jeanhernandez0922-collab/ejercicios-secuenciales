// PROCESO PARA SACAR EL 15% DE DESCUENTO EN LA COMPRA QUE TU HAGAS 
PROCESO SACAR_EL_15_PORCIENTO_DE_DESCUENTO_EN_UNA_COMPRA
 	ESCRIBIR "BIENVENIDO, ESTE PROGRAMA TE AYUDARA A SACAR EL 15% DE DESCUENTO EN LA COMPRA QUE DESEES"
 	ESCRIBIR "DIGITE EL VALOR TOTAL"
 	LEER VALORTOTAL
 	DESCUENTO = VALORTOTAL * 15 / 100
 	RESULTADO = VALORTOTAL - DESCUENTO
 	ESCRIBIR "SI EL VALOR DE TU COMPRA ES DE ", VALORTOTAL, ", ENTONCES SI LE APLICAMOS EL DESCUENTO DEL 15% TE TOCARA PAGAR ", RESULTADO
 	ESCRIBIR "ESE SI QUE ES UN BUEN DESCUENTO POR QUE TE AHORRAS", DESCUENTO
FINPROCESO
