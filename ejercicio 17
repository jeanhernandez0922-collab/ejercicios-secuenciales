Algoritmo LLEGADA_CIUDAD_B
	Escribir "HORA DE SALIDA EN HORAS, MINUTOS Y SEGUNDOS"
	Leer HH, MM, SS
	Escribir "TIEMPO DE VIAJE EN SEGUNDOS"
	Leer T
	TOTAL_SEG = HH * 3600 + MM * 60 + SS + T
	H_FIN = trunc(TOTAL_SEG / 3600) MOD 24 // TOCA PASAR TODO A SEGUNDOS 
	M_FIN = trunc((TOTAL_SEG MOD 3600) / 60)
	S_FIN = TOTAL_SEG MOD 60
	Escribir "LA HORA DE LLEGADA ES: ", H_FIN, ":", M_FIN, ":", S_FIN
FinAlgoritmo
