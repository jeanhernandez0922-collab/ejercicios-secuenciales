Algoritmo DISTANCIA_NUMEROS
	Escribir "TE DIRE LA DISTANCIA DE LOS 2 NUMEROS QUE TU QUIERAS"
	Escribir "DIGITE EL PRIMER NUMERO"
	Leer N1
	Escribir "DIGITE EL SEGUNDO NUMERO"
	Leer N2
	DISTANCIA = ABS (N1 - N2) // EL ABS AYUDA A QUE EL REUSLTADO SEA POSITIVO 
	Escribir "LA DISTANCIA ENTRE ELLOS ES: ", DISTANCIA
FinAlgoritmo
